{
  "name": "snippet-dashboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Minimal Vue wrapper that lists and renders independent, self-contained HTML snippets.",
  "scripts": {
    "snippets:manifest": "node scripts/generate-manifest.mjs",
    "predev": "npm run snippets:manifest",
    "dev": "vite",
    "prebuild": "npm run snippets:manifest",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:snippets": "tsc -p tsconfig.snippets.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
